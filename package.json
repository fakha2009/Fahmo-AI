{
  "name": "fahmo-ai-frontend",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Production-oriented, dependency-free adaptive PWA frontend for Fahmo AI.",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node server.mjs --dev",
    "build": "node scripts/build.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p jsconfig.json --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "check": "node scripts/check-syntax.mjs",
    "verify": "npm run check && npm test",
    "smoke": "node scripts/smoke.mjs",
    "validate": "npm run lint && npm run typecheck && npm run verify && npm run build && npm run smoke"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.0",
    "@types/node": "^24.2.0",
    "eslint": "^9.32.0",
    "globals": "^16.3.0",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22 <25"
  }
}
