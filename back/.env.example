# === База данных ===
DATABASE_URL=postgresql://user:password@localhost:5432/fahmo_ai

# === Приложение ===
APP_URL=http://localhost:8787
FRONTEND_ORIGIN=http://localhost:4173
HTTP_PORT=8787
# Railway injects PORT automatically; it is used when HTTP_PORT is absent.
SESSION_SECRET=change-me-session-secret-64-char-random-xxxxxxxx
DATA_ENCRYPTION_KEY=change-me-data-encryption-key-32-char-xxxx
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173,http://127.0.0.1:8787,http://localhost:8787

# === AI-провайдеры ===
# GEMINI_MODEL: рабочий alias для новых аккаунтов — gemini-flash-latest
# (gemini-2.5-flash закрыта для новых пользователей, 404).
GEMINI_API_KEY=
GEMINI_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=

# === Маршрутизация провайдеров ===
AI_VISION_PROVIDER_ORDER=gemini
AI_TEXT_PROVIDER_ORDER=deepseek,gemini
AI_CLARIFICATION_PROVIDER_ORDER=deepseek,gemini
AI_FALLBACK_ENABLED=true

# === Лимиты ===
MAX_UPLOAD_BYTES=10485760
MAX_PDF_PAGES=20
MAX_IMAGE_COUNT=20
MAX_TEXT_LENGTH=50000

# === Сессии и сроки ===
ANONYMOUS_SESSION_TTL_DAYS=30

# === Web Push ===
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=

# === Cron ===
CRON_SECRET=
