{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "enum": [
        "UNCLEAR_TEXT",
        "AMBIGUOUS_DATE",
        "AMBIGUOUS_AMOUNT",
        "CONFLICTING_INFORMATION",
        "MISSING_INFORMATION",
        "LOW_CONFIDENCE",
        "UNSUPPORTED_CONTENT"
      ]
    },
    "messageKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^errors\\.[a-zA-Z0-9_.]+$"
    },
    "params": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "critical"
      ]
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "clientPageId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "sourceAssetId": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 20,
                "maxLength": 40,
                "pattern": "^[a-z0-9]+$"
              },
              {
                "type": "null"
              }
            ]
          },
          "inputIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "pageNumber": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "excerpt": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ]
          },
          "boundingBox": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "width": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 1
                  },
                  "height": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 1
                  }
                },
                "required": [
                  "x",
                  "y",
                  "width",
                  "height"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "clientPageId",
          "sourceAssetId",
          "inputIndex",
          "pageNumber",
          "excerpt",
          "boundingBox"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "code",
    "messageKey",
    "params",
    "severity",
    "sourceRefs"
  ],
  "additionalProperties": false
}
