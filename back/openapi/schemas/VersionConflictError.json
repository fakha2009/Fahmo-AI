{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "const": "VERSION_CONFLICT"
        },
        "messageKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^errors\\.[a-zA-Z0-9_.]+$"
        },
        "params": {
          "type": "object",
          "properties": {
            "serverRevision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "serverRevision"
          ],
          "additionalProperties": false
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "requestId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "retryable": {
          "type": "boolean",
          "const": false
        },
        "details": {
          "default": null,
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "code",
        "messageKey",
        "params",
        "message",
        "requestId",
        "retryable",
        "details"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "error"
  ],
  "additionalProperties": false
}
