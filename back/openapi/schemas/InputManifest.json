{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "minItems": 1,
  "maxItems": 100,
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "clientPageId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      },
      "fileIndex": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "sourcePageNumber": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          {
            "type": "null"
          }
        ]
      },
      "finalOrder": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "rotation": {
        "anyOf": [
          {
            "type": "number",
            "const": 0
          },
          {
            "type": "number",
            "const": 90
          },
          {
            "type": "number",
            "const": 180
          },
          {
            "type": "number",
            "const": 270
          }
        ]
      },
      "crop": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "width": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1
              },
              "height": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "x",
              "y",
              "width",
              "height"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "clientPageId",
      "fileIndex",
      "sourcePageNumber",
      "finalOrder",
      "rotation",
      "crop"
    ],
    "additionalProperties": false
  }
}
