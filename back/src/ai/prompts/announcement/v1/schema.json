{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fahmo-ai/prompts/announcement/v1/output",
  "title": "Результат анализа объявления",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "documentType",
    "detectedLanguages",
    "summary",
    "simpleExplanation",
    "tasks",
    "dates",
    "amounts",
    "locations",
    "contacts",
    "requiredDocuments",
    "links",
    "warnings",
    "clarificationQuestions",
    "overallConfidence"
  ],
  "properties": {
    "title": { "type": "string", "minLength": 1, "maxLength": 500, "description": "Краткое название документа" },
    "documentType": { "enum": ["announcement", "work_assignment", "handwritten_note", "contract", "invoice", "certificate", "identity", "statement", "letter", "notice", "receipt", "other"] },
    "detectedLanguages": { "type": "array", "maxItems": 10, "items": { "type": "string", "pattern": "^[a-z]{2,3}$" }, "description": "Коды языков документа (ISO 639-1)" },
    "summary": { "type": "string", "minLength": 1, "maxLength": 8000 },
    "simpleExplanation": { "type": "string", "minLength": 1, "maxLength": 8000 },
    "tasks": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/task" } },
    "dates": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/date" } },
    "amounts": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/amount" } },
    "locations": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/location" } },
    "contacts": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/contact" } },
    "requiredDocuments": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/requiredDocument" } },
    "links": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/link" } },
    "warnings": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/warning" } },
    "clarificationQuestions": { "type": "array", "maxItems": 3, "items": { "$ref": "#/$defs/clarificationQuestion" } },
    "overallConfidence": { "enum": ["high", "medium", "low"] }
  },
  "$defs": {
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clientPageId", "inputIndex", "pageNumber", "excerpt"],
      "properties": {
        "clientPageId": { "type": "string", "minLength": 1, "maxLength": 100 },
        "sourceAssetId": { "type": ["string", "null"] },
        "inputIndex": { "type": "integer", "minimum": 0 },
        "pageNumber": { "type": ["integer", "null"], "minimum": 1 },
        "excerpt": { "type": ["string", "null"], "maxLength": 2000 },
        "boundingBox": { "$ref": "#/$defs/boundingBox" }
      }
    },
    "boundingBox": {
      "type": ["object", "null"],
      "description": "Для изображения/PDF: обязательная точная рамка excerpt в долях страницы 0..1; null только для plain text или невидимого фрагмента.",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1, "description": "Левая граница / ширина страницы" },
        "y": { "type": "number", "minimum": 0, "maximum": 1, "description": "Верхняя граница / высота страницы" },
        "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1, "description": "Ширина рамки / ширина страницы" },
        "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1, "description": "Высота рамки / высота страницы" }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "description", "simpleTitle", "simpleDescription", "assigneeText", "priority", "status", "deadline", "confidence", "sourceRefs", "requiresClarification"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64, "description": "Локальный стабильный идентификатор задачи в рамках ответа" },
        "title": { "type": "string", "minLength": 1, "maxLength": 500 },
        "description": { "type": ["string", "null"], "maxLength": 2000 },
        "simpleTitle": { "type": "string", "minLength": 1, "maxLength": 500 },
        "simpleDescription": { "type": ["string", "null"], "maxLength": 2000 },
        "assigneeText": { "type": ["string", "null"], "maxLength": 500 },
        "priority": { "enum": ["high", "medium", "low"] },
        "status": { "enum": ["pending", "completed", "cancelled"] },
        "deadline": { "anyOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] },
        "confidence": { "enum": ["high", "medium", "low"] },
        "sourceRefs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceRef" } },
        "requiresClarification": { "type": "boolean" }
      }
    },
    "date": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rawText", "isoDate", "isoDateTime", "timezone", "kind", "isApproximate", "confidence", "sourceRefs"],
      "properties": {
        "rawText": { "type": "string", "minLength": 1, "maxLength": 500 },
        "isoDate": { "type": ["string", "null"], "format": "date", "description": "YYYY-MM-DD или null, если дата неоднозначна" },
        "isoDateTime": { "type": ["string", "null"], "format": "date-time" },
        "timezone": { "type": ["string", "null"], "description": "IANA timezone, например Asia/Dushanbe" },
        "kind": { "enum": ["deadline", "event_start", "event_end", "reminder", "other"] },
        "isApproximate": { "type": "boolean" },
        "confidence": { "enum": ["high", "medium", "low"] },
        "sourceRefs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceRef" } }
      }
    },
    "amount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rawText", "value", "currency", "confidence", "sourceRefs"],
      "properties": {
        "rawText": { "type": "string", "minLength": 1, "maxLength": 500 },
        "value": { "type": ["string", "null"], "pattern": "^-?\\d+(\\.\\d+)?$", "description": "Число как строка или null, если сумма неоднозначна" },
        "currency": { "type": ["string", "null"], "pattern": "^[A-Z]{3}$" },
        "confidence": { "enum": ["high", "medium", "low"] },
        "sourceRefs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceRef" } }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rawText", "name", "address", "confidence", "sourceRefs"],
      "properties": {
        "rawText": { "type": "string", "minLength": 1, "maxLength": 500 },
        "name": { "type": ["string", "null"], "maxLength": 500 },
        "address": { "type": ["string", "null"], "maxLength": 1000 },
        "confidence": { "enum": ["high", "medium", "low"] },
        "sourceRefs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceRef" } }
      }
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rawText", "type", "value", "confidence", "sourceRefs"],
      "properties": {
        "rawText": { "type": "string", "minLength": 1, "maxLength": 500 },
        "type": { "enum": ["phone", "email", "link", "other"] },
        "value": { "type": ["string", "null"], "maxLength": 500 },
        "confidence": { "enum": ["high", "medium", "low"] },
        "sourceRefs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceRef" } }
      }
    },
    "requiredDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "confidence", "sourceRefs"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 500 },
        "description": { "type": ["string", "null"], "maxLength": 2000 },
        "confidence": { "enum": ["high", "medium", "low"] },
        "sourceRefs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceRef" } }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rawText", "url", "confidence", "sourceRefs"],
      "properties": {
        "rawText": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "url": { "type": ["string", "null"], "format": "uri" },
        "confidence": { "enum": ["high", "medium", "low"] },
        "sourceRefs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceRef" } }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "messageKey", "params", "severity", "sourceRefs"],
      "properties": {
        "code": { "enum": ["UNCLEAR_TEXT", "AMBIGUOUS_DATE", "AMBIGUOUS_AMOUNT", "CONFLICTING_INFORMATION", "MISSING_INFORMATION", "LOW_CONFIDENCE", "UNSUPPORTED_CONTENT"] },
        "messageKey": { "type": "string", "pattern": "^errors\\.[a-zA-Z0-9_.]+$", "description": "Ключ локализации сообщения, начинается с errors." },
        "params": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean", "null"] } },
        "severity": { "enum": ["info", "warning", "critical"] },
        "sourceRefs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceRef" } }
      }
    },
    "clarificationQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fieldPath", "question", "suggestedAnswers", "required"],
      "properties": {
        "fieldPath": { "type": "string", "minLength": 1, "maxLength": 200, "description": "Путь к недостающему полю результата, например dates" },
        "question": { "type": "string", "minLength": 1, "maxLength": 500 },
        "suggestedAnswers": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
        "required": { "type": "boolean" }
      }
    }
  }
}
